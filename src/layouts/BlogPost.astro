---
import BasicLayout from "./Basic.astro";
import NextProject from "@/components/NextProject.astro";
import { toTitleCase } from "@/scripts/typography";
import { formatDateRange } from "@/scripts/cleanDate";
import { normalizeMediaSrc, posterFromMediaSrc } from "@/scripts/mediaPath";
import { parseMarkdown, parseMarkdownInline } from "@/utils/markdown.js";
import { externalLinkAttrs } from "@/utils/externalLinks.js";
import type { CollectionEntry } from "astro:content";
type Props = CollectionEntry<"work">["data"];
type PostProps = Props & { slug?: string };
import { SITE_TITLE } from "@/consts";
import { existsSync } from "node:fs";
import path from "node:path";
import Media from "@/components/utils/Media.astro";

const {
  title,
  description,
  excerpt,
  buttons = [],
  credit,
  recognition = [],
  roles,
  tags,
  startDate,
  endDate,
  heroImage,
  images = [],
  slug,
} = Astro.props as PostProps;

const parsedDescription = description
  ? parseMarkdown(description, { gfm: true })
  : null;

const parsedCredit = credit
  ? parseMarkdown(credit, { gfm: true }).replace(/<(\/?)h3\b/g, "<$1h2")
  : null;
const parsedExcerpt =
  parsedDescription?.match(/<p>(.*?)<\/p>/s)?.[1].replace(/<[^>]+>/g, "") ||
  excerpt?.trim();
const parsedRecognition = recognition.map((item) => parseMarkdownInline(item));
const heroSrc = normalizeMediaSrc(heroImage);
const heroPoster = posterFromMediaSrc(heroImage);
const workOgImage = slug ? `/assets/og/work/${slug}.jpg` : null;
const workOgPath = slug
  ? path.resolve("src/assets/og/work", `${slug}.jpg`)
  : null;
const hasGeneratedWorkOg = workOgPath ? existsSync(workOgPath) : false;
const socialImage = heroImage
  ? hasGeneratedWorkOg
    ? workOgImage
    : /\.(mp4|webm|ogg)$/i.test(heroSrc)
      ? heroPoster
      : heroSrc
  : hasGeneratedWorkOg
    ? workOgImage
    : normalizeMediaSrc(images[0]);
---

<BasicLayout
  title={`${title} — ${SITE_TITLE}`}
  description={parsedExcerpt}
  image={socialImage}
  activeNavHref="/work/"
>
  <main id="main-content" tabindex="-1">
    <div
      class="fade-in grid flex-col gap-4 px-[var(--page-margin)] py-4 md:grid-cols-3 md:gap-8"
    >
      <h1 class="title heading1 col-span-2">{title}</h1>
      <p class="code text-balance text-gray-600">
        {tags.map((tag) => toTitleCase(tag)).join(", ")},{" "}
        {startDate && formatDateRange(startDate, endDate)}
      </p>
    </div>
    {
      buttons.length > 0 && (
        <div class="button-group mt-2 px-[var(--page-margin)]">
          {buttons.map((item) => (
            <a
              class="heading3 pill-button fade-in"
              href={item[1]}
              title={item[0]}
              {...externalLinkAttrs(item[1])}
            >
              <span class="pill-button-label">{item[0]}</span>
            </a>
          ))}
        </div>
      )
    }
    <div class="fade-in m-auto flex justify-center pt-10">
      <Media
        src={heroSrc}
        alt=""
        fadeIn={false}
        widthAuto={true}
        isVideo={/\.(mp4|webm|ogg|mov|m4v)(?:$|[?#])/i.test(heroSrc)}
        className="mb-10 aspect-[16/9] h-auto overflow-hidden rounded-2xl lg:max-w-[80%]"
      />
    </div>
    <div class="relative mt-2 mb-8 lg:mt-20 lg:mb-28">
      <input type="checkbox" id="expand-article" class="peer sr-only md:hidden" aria-label="Show full project details" />

      <article
        class="fade-in mb-8 grid max-h-[20vh] gap-10 overflow-hidden transition-all duration-300 peer-checked:max-h-[200rem] md:max-h-none md:grid-cols-3"
      >
        <!-- your full article content here -->
        {
          parsedDescription && (
            <div
              class="heading2 col-span-2 flex max-w-prose flex-col gap-2 px-[var(--page-margin)] font-light text-pretty text-[#0A0A0A] prose-p:indent-[2em] prose-p:font-[300] prose-p:text-pretty prose-p:first-of-type:indent-[6em]"
              set:html={parsedDescription}
            />
          )
        }

        <div
          class="grid w-full flex-col gap-4 gap-x-20 px-[var(--page-margin)] 2xl:grid-cols-2"
        >
          {
            parsedCredit && (
              <div
                class="credit body1 max-w-prose !leading-normal text-pretty prose-h2:mb-2 prose-h2:font-bold prose-h2:not-first:mt-4"
                set:html={parsedCredit}
              />
            )
          }
          {
            recognition.length > 0 && (
              <div>
                <h2 class="body1 mb-4 font-bold">Recognitions</h2>
                <ul class="body1 flex flex-col gap-2">
                  {parsedRecognition.map((item) => (
                    <li set:html={item} class="leading-normal" />
                  ))}
                </ul>
              </div>
            )
          }
        </div>
      </article>

      <!-- FADE overlay for collapsed state only -->
      <div
        class="pointer-events-none absolute inset-x-0 bottom-10 h-32 bg-[linear-gradient(to_top,white_30%,transparent_70%)] peer-checked:hidden md:hidden"
      >
      </div>

      <!-- Toggle buttons -->
      <label
        for="expand-article"
        class="heading2 block cursor-pointer px-[var(--page-margin)] peer-focus-visible:outline-2 peer-focus-visible:-outline-offset-2 peer-checked:hidden md:hidden"
      >
        + View more
      </label>
      <label
        for="expand-article"
        class="heading2 hidden cursor-pointer px-[var(--page-margin)] peer-focus-visible:outline-2 peer-focus-visible:-outline-offset-2 peer-checked:block md:hidden"
      >
        - View less
      </label>
    </div>

    <div
      class="code prose-p:fade-in slot work-content body2 flex flex-col gap-4 px-[var(--page-margin)] pt-4 text-gray-600 xl:grid xl:gap-4 2xl:grid-cols-2 prose-img:mb-2"
    >
      <slot />
    </div>

    <NextProject />
  </main>

  <script>
    const slot = document.querySelectorAll(".slot > *");

    slot.forEach((p) => {
      p.classList.add("fade-in");
      p.classList.add("text-pretty");
    });
  </script>
</BasicLayout>
