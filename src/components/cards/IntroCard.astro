---
const {
  size,
  background,
  textColor,
  variant,
  body,
  linkContent,
  linkLabel,
  linkHref,
  links,
} = Astro.props;
import DraggableCard from "@/components/global/DraggableCard.astro";
import HeroSketch from "@/components/global/HeroSketch.astro";
import { SITE_DESCRIPTION } from "../../consts";
import { parseMarkdown } from "@/utils/markdown.js";
import ExternalLinkArrow from "@/components/utils/ExternalLinkArrow.astro";
import { externalLinkAttrs } from "@/utils/externalLinks.js";

const cardBackground = background ?? "black";
const cardTextColor = textColor ?? "white";
const hasBody = typeof body === "string" && body.trim().length > 0;
const introBody = hasBody
  ? body
  : variant === "trinity"
    ? ""
    : SITE_DESCRIPTION;
const hasCustomHref = Boolean(linkHref);
const introLinkHref = linkHref || "/about";
const introLinkLabel =
  linkContent ||
  linkLabel ||
  (hasCustomHref ? "Learn more" : "Learn more about me");
const introBodyHtml = introBody ? parseMarkdown(introBody) : "";
---

<DraggableCard>
  <div
    class={`${size} home-card flex flex-col p-4 `}
    style={`background: ${cardBackground}; color: ${cardTextColor};`}
  >
    {
      variant !== "trinity" && (
        <a
          href={introLinkHref}
          class="body2"
          {...externalLinkAttrs(introLinkHref)}
        >
          {introLinkLabel}
          <ExternalLinkArrow />
        </a>
      )
    }
    <div class="mt-4 flex min-h-0 flex-1 flex-col gap-3">
      {
        variant === "trinity" ? (
          <div class="trinity-wrapper">
            <div
              class="trinity-canvas"
              data-trinity-sketch
              role="img"
              aria-label="Munus practice map connecting code, commons, and community through p5 tools, publishing, teaching, and organizing"
            />
            <ul class="trinity-links" aria-label="Explore my practice">
              {links?.map(({ label, href }) => (
                <li>
                  <a href={href} data-trinity-link>
                    {label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ) : (
          <HeroSketch />
        )
      }
      {
        introBodyHtml && (
          <div
            class="body1 custom-body shrink-0 text-balance"
            set:html={introBodyHtml}
          />
        )
      }
    </div>
  </div>
  <style>
    .trinity-wrapper {
      position: relative;
      margin-inline: 0;
      width: 100%;
      height: 100%;
      min-height: 0;
      container-type: inline-size;
    }

    .trinity-links {
      display: flex;
      flex-wrap: wrap;
      gap: 0.75rem;
      position: absolute;
      inset: 0;
      align-items: center;
      justify-content: center;
      align-content: center;
      pointer-events: none;
    }

    [data-trinity-link] {
      pointer-events: auto;
      display: grid;
      position: absolute;
      place-items: center;
      transform: translate(-50%, -50%);
      width: 25%;
      height: 26%;
      border-radius: 50%;
      border: 1px solid currentColor;
      color: white;
      font-size: max(12px, 3.7cqi);
    }

    .trinity-links li:nth-child(1) [data-trinity-link] {
      left: 19%;
      top: 26%;
    }

    .trinity-links li:nth-child(2) [data-trinity-link] {
      left: 81%;
      top: 26%;
    }

    .trinity-links li:nth-child(3) [data-trinity-link] {
      left: 50%;
      top: 82%;
    }

    .trinity-canvas[data-drawn] + .trinity-links [data-trinity-link] {
      border-color: transparent;
    }

    [data-trinity-link]:focus-visible {
      outline: 2px dashed currentColor;
      outline-offset: 2px;
    }

    .trinity-canvas {
      display: flex;
      justify-content: center;
      align-items: center;
      background: transparent;
      width: 100%;
      aspect-ratio: 100 / 96;
      overflow: hidden;
    }

    .trinity-canvas :global(canvas) {
      display: block;
      margin-inline: auto;
      width: 100% !important;
      max-width: none;
      height: auto !important;
      max-height: none;
    }

    @media (prefers-reduced-motion: no-preference) {
      .trinity-canvas :global(canvas) {
        animation: trinity-enter 280ms ease-out;
      }

      @keyframes trinity-enter {
        from { opacity: 0; }
        to { opacity: 1; }
      }
    }
  </style>
</DraggableCard>
{variant === "trinity" && <script src="../../scripts/trinityDiagram.js" />}
