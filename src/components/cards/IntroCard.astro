---
const {
  size,
  background,
  textColor,
  variant,
  body,
  linkContent,
  linkLabel,
  linkHref,
} = Astro.props;
import DraggableCard from "@/components/global/DraggableCard.astro";
import HeroSketch from "@/components/global/HeroSketch.astro";
import { SITE_DESCRIPTION } from "../../consts";
import { parseMarkdown } from "@/utils/markdown.js";
import { externalLinkAttrs } from "@/utils/externalLinks.js";

const cardBackground = background ?? "black";
const cardTextColor = textColor ?? "white";
const hasBody = typeof body === "string" && body.trim().length > 0;
const introBody = hasBody
  ? body
  : variant === "trinity"
    ? ""
    : SITE_DESCRIPTION;
const hasCustomHref = Boolean(linkHref);
const introLinkHref = linkHref || "/about";
const introLinkLabel =
  linkContent ||
  linkLabel ||
  (hasCustomHref ? "Learn more" : "Learn more about me");
const introBodyHtml = introBody ? parseMarkdown(introBody) : "";
---

<DraggableCard>
  <div
    class={`${size} home-card flex flex-col p-4 `}
    style={`background: ${cardBackground}; color: ${cardTextColor};`}
  >
    <a
      href={introLinkHref}
      class="linkout body2"
      {...externalLinkAttrs(introLinkHref)}
    >
      {introLinkLabel}
    </a>
    <div class="mt-4 flex min-h-0 flex-1 flex-col gap-3">
      {
        variant === "trinity" ? (
          <div class="trinity-wrapper">
            <div
              class="trinity-canvas"
              data-trinity-sketch
              role="img"
              aria-label="Munus practice map connecting code, commons, and community through p5 tools, publishing, teaching, and organizing"
            />
          </div>
        ) : (
          <HeroSketch />
        )
      }
      {
        introBodyHtml && (
          <div
            class="body1 custom-body shrink-0 text-balance"
            set:html={introBodyHtml}
          />
        )
      }
    </div>
  </div>
  <style>
    .trinity-wrapper {
      margin-inline: 0;
      width: 100%;
      height: 100%;
      min-height: 0;
    }

    .trinity-canvas {
      display: flex;
      justify-content: center;
      align-items: center;
      background: transparent;
      width: 100%;
      height: 100%;
      overflow: hidden;
    }

    .trinity-canvas :global(canvas) {
      display: block;
      margin-inline: auto;
      width: 100% !important;
      max-width: none;
      height: auto !important;
      max-height: none;
    }
  </style>
</DraggableCard>
{variant === "trinity" && <script src="../../scripts/trinityDiagram.js" />}
