---
// Media.astro
const {
  src,
  alt = "",
  isVideo = false,
  fit = "cover",
  scaling = 1,
  cropped = false,
  className = "",
  widthAuto = false,
  usePoster = true,
  placeholder = true,
} = Astro.props;
import { normalizeMediaSrc, posterFromMediaSrc } from "@/scripts/mediaPath.js";
import { localMediaPath, mediaDimensions } from "@/utils/mediaMetadata.js";
import { getImage } from "astro:assets";
const resolvedSrc = normalizeMediaSrc(src);
const possiblePoster = posterFromMediaSrc(resolvedSrc);
const posterSrc = possiblePoster?.startsWith("/") && !localMediaPath(possiblePoster) ? undefined : possiblePoster;
const dimensions = await mediaDimensions(resolvedSrc, Boolean(isVideo));
const optimizedImage = !isVideo && dimensions.width && dimensions.height && /\.(jpe?g|png|webp|avif)$/i.test(resolvedSrc)
  ? await getImage({ src: resolvedSrc, width: dimensions.width, height: dimensions.height, widths: [640, 1080, 1920].filter((width) => width <= dimensions.width), quality: 80 })
  : undefined;
// Astro's dev image URLs omit the slash required by this site's routing.
const imageSrc = optimizedImage?.src.replace("/_image?", "/_image/?");
const imageSrcset = optimizedImage?.srcSet.attribute.replaceAll("/_image?", "/_image/?");
const stillSrc = resolvedSrc.startsWith("/assets/") && /\.gif$/i.test(resolvedSrc)
  ? resolvedSrc.replace("/assets/", "/assets/posters/").replace(/\.gif$/i, ".webp")
  : undefined;
const hasStill = Boolean(stillSrc && localMediaPath(stillSrc));
const ImageContainer = hasStill ? "picture" : Fragment;
const placeholderClass = placeholder ? "media-placeholder" : "";
const fallbackRatio = dimensions.width ? undefined : "16 / 9";
const fitClass = fit === "contain" ? "object-contain" : "object-cover";
---

{
  isVideo ? (
    <video
      preload="none"
      data-lazy-video
      data-src={resolvedSrc}
      width={dimensions.width}
      height={dimensions.height}
      poster={usePoster ? posterSrc || undefined : undefined}
      loop
      muted
      playsinline
      webkit-playsinline
      class={`media ${placeholderClass} *:h-auto ${widthAuto ? "w-auto" : "w-full"} ${fitClass} ${cropped ? "[clip-path:inset(-3px)]" : ""} ${className}`}
      style={{ transform: `scale(${scaling})`, aspectRatio: fallbackRatio }}
      alt={alt}
    >
      Your browser does not support the video tag.
    </video>
  ) : (
    <ImageContainer {...(hasStill ? { style: "display: contents" } : {})}>
      {hasStill && (
        <source media="(prefers-reduced-motion: reduce)" srcset={encodeURI(stillSrc!)} />
      )}
      <img
      src={imageSrc || resolvedSrc}
      srcset={imageSrcset || undefined}
      sizes={optimizedImage ? "(max-width: 767px) 100vw, 75vw" : undefined}
      width={dimensions.width}
      height={dimensions.height}
      alt={alt}
      loading="lazy"
      decoding="async"
      style={{ aspectRatio: fallbackRatio }}
      class={`media ${placeholderClass} h-auto ${widthAuto ? "w-auto" : "w-full"} ${fitClass} ${cropped ? "[clip-path:inset(-3px)]" : ""} ${className}`}
      />
    </ImageContainer>
  )
}

{isVideo && <noscript><video src={resolvedSrc} poster={usePoster ? posterSrc : undefined} width={dimensions.width} height={dimensions.height} controls muted playsinline preload="none" class={`media w-full ${fitClass} ${className}`}></video><style>video[data-lazy-video] { display: none; }</style></noscript>}

<script>
  import "@/scripts/lazyMedia.js";
</script>
