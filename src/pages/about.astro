---
import BasicLayout from "@/layouts/Basic.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "@/consts";
import aboutContentMarkdown from "@/docs/about/about-munus.md?raw";
import cloutMarkdown from "@/docs/about/clout.md?raw";
import Media from "@/components/utils/Media.astro";
import FullListCard from "@/components/cards/FullListCard.astro";
import PDFResumeText from "@/components/PDFResumeText.astro";
import { parseMarkdown } from "@/utils/markdown.js";

const aboutContentHtml = parseMarkdown(aboutContentMarkdown);
const cloutHtml = parseMarkdown(cloutMarkdown);
---

<BasicLayout
  title={`About — ${SITE_TITLE}`}
  description={SITE_DESCRIPTION}
  image={`/assets/og/pages/about.jpg`}
>
  <main class="p-[var(--page-margin)]">
    <Media
      src={"/assets/about/m-station.webp"}
      alt="Munus Shih wearing glasses and a tan cap in a sunlit transit station"
      isVideo={false}
    />
    <section
      class="mt-10 grid auto-cols-min auto-rows-min grid-cols-1 gap-0 pb-20 lg:grid-cols-2"
    >
      <article
        class="heading2 fade-in flex flex-col gap-4 prose-p:indent-[2em] prose-p:text-pretty prose-p:first-of-type:indent-[6em]"
        set:html={aboutContentHtml}
      />
      <div
        class="clout heading2 fade-in mt-20 lg:mt-0 lg:text-right prose-li:font-bold"
        set:html={cloutHtml}
      />
    </section>

    <section class="fade-in">
      <PDFResumeText />
    </section>

    <section class="fade-in">
      <div class="swiper">
        <div class="swiper-wrapper">
          <div class="swiper-slide">
            <FullListCard title="Recent Events" />
          </div>
          <div class="swiper-slide">
            <FullListCard title="Talk" />
          </div>
          <div class="swiper-slide">
            <FullListCard title="Teaching" />
          </div>
          <div class="swiper-slide">
            <FullListCard title="Workshop" />
          </div>
          <div class="swiper-slide">
            <FullListCard title="Exhibition" />
          </div>
          <div class="swiper-slide">
            <FullListCard title="Featured" />
          </div>
          <div class="swiper-slide">
            <FullListCard title="Organizing" />
          </div>
          <div class="swiper-slide">
            <FullListCard title="Press" />
          </div>
        </div>
      </div>
    </section>
  </main>
</BasicLayout>
<script>
  import Swiper from "swiper";
  import { Autoplay } from "swiper/modules";
  import "swiper/css";
  let swiperInstance = null;

  function initSwiper() {
    if (window.matchMedia("(min-width: 768px)").matches) {
      if (!swiperInstance) {
        swiperInstance = new Swiper(".swiper", {
          modules: [Autoplay],
          slidesPerView: "auto",
          grabCursor: true,
          loop: true, // Enable loop for seamless swiping
          autoplay: {
            delay: 10000,
            disableOnInteraction: true,
          },
        });
      }
    } else {
      if (swiperInstance) {
        swiperInstance.destroy(true, true);
        swiperInstance = null;
      }
    }
  }

  window.addEventListener("load", initSwiper);
  window.addEventListener("resize", initSwiper);
</script>

<style>
  .clout :global(li:last-child) {
    margin-top: 0.75em;
  }

  .clout :global(li:last-child a) {
    display: inline-flex;
    align-items: center;
    padding: 0.5rem 1rem;
    border: 1px solid #000;
    border-radius: 0.5rem;
    color: #000;
    font-weight: 500;
    text-decoration: none;
    cursor: pointer;
    transition: all 150ms ease;
  }

  .clout :global(li:last-child a:hover) {
    color: #fff;
    background: #000;
  }

  .clout :global(li:last-child a:focus) {
    outline: none;
    box-shadow: 0 0 0 2px #000;
  }

  .swiper-slide {
    display: flex;
    width: 30vw;
    min-width: 300px;
    max-width: 800px;
    height: max-content;
    overflow: hidden;
  }

  @media (max-width: 768px) {
    .swiper-slide {
      width: 100%; /* Full width on mobile */
    }
  }

  .swiper-wrapper {
    display: flex;
    flex-direction: row;
    gap: 10px; /* Adjust gap as needed */
  }

  @media (max-width: 768px) {
    .swiper-wrapper {
      flex-direction: column; /* Change to column layout on mobile */
    }
  }
</style>
