---
import BasicLayout from "@/layouts/Basic.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "@/consts";
import aboutContentMarkdown from "@/docs/about/about-munus.md?raw";
import cloutMarkdown from "@/docs/about/clout.md?raw";
import Media from "@/components/utils/Media.astro";
import FullListCard from "@/components/cards/FullListCard.astro";
import PDFResumeText from "@/components/PDFResumeText.astro";
import { parseMarkdown } from "@/utils/markdown.js";

const bioFaviconOverrides = {
  "www.pratt.edu":
    "https://www.pratt.edu/wp-content/themes/pratt/static/img/favicon/favicon.ico",
  "parsons.edu":
    "https://parsons.edu/dt-2023/wp-content/uploads/sites/26/2023/05/cropped-entropy-icon-32x32.png",
  "p5-book.vercel.app":
    "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Ctext y='.9em' font-size='90'%3E%F0%9F%93%96%3C/text%3E%3C/svg%3E",
  "p5js.org": "https://p5js.org/favicon.ico",
  "coassembly.work": "https://coassembly.work/favicon.svg",
  "pcd.sponact.org": "https://pcd.sponact.org/assets/images/sponact-favicon.jpg",
  "otherislands.designfuture.space":
    "https://otherislands.designfuture.space/images/favicon.svg",
  "ci2-munus.munusandniktari.com":
    "https://ci2-munus.munusandniktari.com/apple-touch-icon.png",
  "sfpc.study": "https://sfpc.study/images/sessions/favicon.ico",
  "tisch.nyu.edu":
    "https://tisch.nyu.edu/apps/settings/wcm/designs/tisch/favicon.ico",
  "www.harvarduxd.com":
    "https://framerusercontent.com/images/iQV6cfoDaQI86MOKuh9ljQerhw4.png",
  "arts.ntu.edu.tw": "https://arts.ntu.edu.tw/images/favicon.ico",
  "2025.typographics.com": "https://2025.typographics.com/favicon.ico",
  "www.rbpmw-efanyc.org":
    "https://images.squarespace-cdn.com/content/v1/537c9f82e4b031913f8e5d37/1400684283590-MJ2GPR0KOJC3LK8FUWQ9/favicon.ico?format=100w",
  "danielirizarry.design":
    "https://danielirizarry.design/wp-content/uploads/2025/11/DI_Favicon_25.png",
  "www.awwwards.com": "https://assets.awwwards.com/assets/images/favicon.svg",
};

function getBioFaviconSrc(href) {
  if (href.startsWith("/")) return "/favicon.svg";

  const hostname = new URL(href).hostname;
  return (
    bioFaviconOverrides[hostname] ??
    `https://www.google.com/s2/favicons?domain_url=${encodeURIComponent(href)}&amp;sz=32`
  );
}

function addFaviconsToLinks(html) {
  return html.replace(/<a\b([^>]*)>/g, (anchor, attributes) => {
    const href = attributes.match(/\bhref="([^"]+)"/)?.[1];
    if (!href) return anchor;

    const faviconSrc = getBioFaviconSrc(href);

    return `${anchor}<img class="bio-link-favicon" src="${faviconSrc}" alt="" aria-hidden="true" loading="lazy" decoding="async" />&#8288;`;
  });
}

const aboutContentHtml = addFaviconsToLinks(
  parseMarkdown(aboutContentMarkdown),
);
const cloutHtml = parseMarkdown(cloutMarkdown);
---

<BasicLayout
  title={`About — ${SITE_TITLE}`}
  description={SITE_DESCRIPTION}
  image={`/assets/og/pages/about.jpg`}
>
  <main class="p-[var(--page-margin)]">
    <Media
      src={"/assets/about/m-station.webp"}
      alt="Munus Shih wearing glasses and a tan cap in a sunlit transit station"
      isVideo={false}
    />
    <section
      class="mt-10 grid auto-cols-min auto-rows-min grid-cols-1 gap-0 pb-20 lg:grid-cols-2"
    >
      <article
        class="heading2 fade-in flex flex-col gap-4 prose-p:indent-[2em] prose-p:text-pretty prose-p:first-of-type:indent-[6em]"
        set:html={aboutContentHtml}
      />
      <div
        class="clout heading2 fade-in mt-20 lg:mt-0 lg:text-right prose-li:font-bold"
        set:html={cloutHtml}
      />
    </section>

    <section class="fade-in">
      <PDFResumeText />
    </section>

    <section class="fade-in">
      <div class="swiper">
        <div class="swiper-wrapper">
          <div class="swiper-slide">
            <FullListCard title="Recent Events" />
          </div>
          <div class="swiper-slide">
            <FullListCard title="Talk" />
          </div>
          <div class="swiper-slide">
            <FullListCard title="Teaching" />
          </div>
          <div class="swiper-slide">
            <FullListCard title="Workshop" />
          </div>
          <div class="swiper-slide">
            <FullListCard title="Exhibition" />
          </div>
          <div class="swiper-slide">
            <FullListCard title="Featured" />
          </div>
          <div class="swiper-slide">
            <FullListCard title="Organizing" />
          </div>
          <div class="swiper-slide">
            <FullListCard title="Press" />
          </div>
        </div>
      </div>
    </section>
  </main>
</BasicLayout>
<script>
  import Swiper from "swiper";
  import { Autoplay } from "swiper/modules";
  import "swiper/css";
  let swiperInstance = null;

  function initSwiper() {
    if (window.matchMedia("(min-width: 768px)").matches) {
      if (!swiperInstance) {
        swiperInstance = new Swiper(".swiper", {
          modules: [Autoplay],
          slidesPerView: "auto",
          grabCursor: true,
          loop: true, // Enable loop for seamless swiping
          autoplay: {
            delay: 10000,
            disableOnInteraction: true,
          },
        });
      }
    } else {
      if (swiperInstance) {
        swiperInstance.destroy(true, true);
        swiperInstance = null;
      }
    }
  }

  window.addEventListener("load", initSwiper);
  window.addEventListener("resize", initSwiper);
</script>

<style>
  article :global(a) {
    background-image: linear-gradient(currentColor, currentColor);
    background-position: left bottom;
    background-repeat: no-repeat;
    background-size: 0 0.06em;
    text-decoration: none;
    transition: background-size 250ms ease;
  }

  article :global(a:hover),
  article :global(a:focus-visible) {
    background-size: 100% 0.06em;
    text-decoration: none;
  }

  article :global(.bio-link-favicon) {
    display: inline-block;
    vertical-align: -0.04em;
    margin-right: 0.2em;
    border-radius: 0.1em;
    width: 0.8em;
    height: 0.8em;
    object-fit: contain;
  }

  @media (prefers-reduced-motion: reduce) {
    article :global(a) {
      transition: none;
    }
  }

  .clout :global(li:last-child) {
    margin-top: 0.75em;
  }

  .clout :global(li:last-child a) {
    display: inline-flex;
    align-items: center;
    padding: 0.5rem 1rem;
    border: 1px solid #000;
    border-radius: 0.5rem;
    color: #000;
    font-weight: 500;
    text-decoration: none;
    cursor: pointer;
    transition: all 150ms ease;
  }

  .clout :global(li:last-child a:hover) {
    color: #fff;
    background: #000;
  }

  .clout :global(li:last-child a:focus) {
    outline: none;
    box-shadow: 0 0 0 2px #000;
  }

  .swiper-slide {
    display: flex;
    width: 30vw;
    min-width: 300px;
    max-width: 800px;
    height: max-content;
    overflow: hidden;
  }

  @media (max-width: 768px) {
    .swiper-slide {
      width: 100%; /* Full width on mobile */
    }
  }

  .swiper-wrapper {
    display: flex;
    flex-direction: row;
    gap: 10px; /* Adjust gap as needed */
  }

  @media (max-width: 768px) {
    .swiper-wrapper {
      flex-direction: column; /* Change to column layout on mobile */
    }
  }
</style>
