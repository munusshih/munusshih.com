---
import BasicLayout from "@/layouts/Basic.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "@/consts";
import { prepareAndSortContent, parseLooseDate } from "@/scripts/cleanDate.js";
import { getTeachingEntries } from "@/data/contentSources.js";
import { localMediaPath } from "@/utils/mediaMetadata.js";
import { normalizeMediaSrc } from "@/scripts/mediaPath.js";
import { repairContentLinks } from "@/utils/contentLinks.js";
import Media from "@/components/utils/Media.astro";
import teachingMedia from "@/data/generated/teachingMedia.json" assert { type: "json" };
import { teachingEntryKey, entryHasTokens } from "@/data/teachingUtils.js";
import { isExplicitFeatureEnabled } from "@/data/homepageUtils.js";
import ExternalLinkArrow from "@/components/utils/ExternalLinkArrow.astro";
import { externalLinkAttrs } from "@/utils/externalLinks.js";
import { teachingPreviews } from "@/data/teachingPreviews";

const cachedTeachingMedia = Object.fromEntries(Object.entries(teachingMedia).map(([key, records]) => [repairContentLinks(key), records]));
const excludedMedia = new Set([
  "/assets/teaching/combinatory-poetry-with-variable-fonts-ft-nikki-makagiansar/combinatory-poetry-with-variable-fonts-ft-nikki-makagiansar-02.jpg",
]);

const teachingEntriesRaw = await getTeachingEntries();
const teachingEntries = prepareAndSortContent(teachingEntriesRaw);

const now = new Date();
const currentYear = now.getFullYear();

const seasonFromMonth = (month) => {
  if (month >= 2 && month <= 4) return "spring";
  if (month >= 5 && month <= 6) return "summer";
  if (month >= 7 && month <= 10) return "fall";
  return "winter";
};

const currentSeason = seasonFromMonth(now.getMonth());

const getSectionName = (item) =>
  String(item.section ?? item.category ?? "")
    .trim()
    .toLowerCase();

const normaliseDate = (item) => {
  if (item._sortDate instanceof Date && !Number.isNaN(item._sortDate.valueOf()))
    return item._sortDate;

  const raw = item.originalDate ?? item.date;
  if (!raw) return null;

  const parsed = parseLooseDate(raw);
  return parsed instanceof Date && !Number.isNaN(parsed.valueOf())
    ? parsed
    : null;
};

const detectSeasonInfo = (item) => {
  const raw = (item.originalDate ?? item.date ?? "").toLowerCase();
  const knownSeason = ["spring", "summer", "fall", "winter"].find((season) =>
    raw.includes(season)
  );

  const yearMatch = (item.originalDate ?? item.date ?? "").match(/\d{4}/);
  const fallbackDate = normaliseDate(item);

  const season =
    knownSeason ??
    (fallbackDate ? seasonFromMonth(fallbackDate.getMonth()) : null);
  const year = yearMatch
    ? Number(yearMatch[0])
    : (fallbackDate?.getFullYear() ?? null);

  return { season, year };
};

const isCourseLike = (item) =>
  entryHasTokens(item, ["course", "class", "teaching", "studio", "lecture"]);

const isWorkshopLike = (item) => entryHasTokens(item, ["workshop", "lab"]);

const isHappeningClass = (item) => {
  if (!isCourseLike(item)) return false;

  if (
    item.ongoing !== undefined &&
    item.ongoing !== null &&
    String(item.ongoing).trim() !== ""
  ) {
    return isExplicitFeatureEnabled(item.ongoing);
  }

  if (
    entryHasTokens(item, [
      "happening",
      "current",
      "ongoing",
      "active",
      "now",
      "upcoming",
    ])
  ) {
    return true;
  }

  const { season, year } = detectSeasonInfo(item);
  if (season && year) {
    return year === currentYear && season === currentSeason;
  }

  const date = normaliseDate(item);
  if (!date) return false;

  const diffDays = Math.abs((date.getTime() - now.getTime()) / 86_400_000);
  return diffDays <= 60;
};

const happeningClassesRaw = [];
const coursesRaw = [];
const workshopsRaw = [];

for (const item of teachingEntries) {
  if (isHappeningClass(item)) {
    happeningClassesRaw.push(item);
    continue;
  }

  if (isWorkshopLike(item)) {
    workshopsRaw.push(item);
    continue;
  }

  if (isCourseLike(item)) {
    coursesRaw.push(item);
    continue;
  }

  coursesRaw.push(item);
}

const usedKeys = new Set([
  ...happeningClassesRaw.map((item) => teachingEntryKey(item)),
  ...coursesRaw.map((item) => teachingEntryKey(item)),
  ...workshopsRaw.map((item) => teachingEntryKey(item)),
]);

const leftoverItems = teachingEntries.filter(
  (item) => !usedKeys.has(teachingEntryKey(item))
);
if (leftoverItems.length) {
  coursesRaw.push(...leftoverItems);
}

const happeningClasses = happeningClassesRaw;
const courses = coursesRaw;
const workshops = workshopsRaw;

const displayDate = (item) => item.originalDate ?? item.date ?? "";

const sections = [
  { title: "Ongoing", items: happeningClasses },
  { title: "Courses", items: courses },
  { title: "Workshop", items: workshops },
];
---

<BasicLayout
  title={`Teaching — ${SITE_TITLE}`}
  description={`${SITE_DESCRIPTION} - Teaching`}
  image={`/assets/og/pages/teaching.jpg`}
>
  <main id="main-content" tabindex="-1" class="w-full">
    <h1 class="sr-only">Teaching</h1>
    {
      sections
        .filter(({ items }) => items.length)
        .map(({ title, items }) => (
          <section class="flex flex-col" aria-label={title}>
            <h2 class="section-title fade-in w-full self-center leading-tight tracking-[-0.1em] [--title-scale:0.24]">
              {title}
            </h2>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 [&>*:first-child]:border-t md:[&>*:last-child]:border-r lg:[&>*:last-child]:border-r lg:[&>*:last-child:nth-child(3n-1)]:!w-full lg:[&>*:last-child:nth-child(3n-1)]:border-x lg:[&>*:last-child:nth-child(3n-2)]:w-[calc(100%+1px)] md:[&>*:last-child:nth-child(odd)]:w-[calc(100%+1px)] md:[&>*:nth-child(-n+2)]:border-t lg:[&>*:nth-child(-n+3)]:border-t md:[&>*:nth-child(2n)]:border-l lg:[&>*:nth-child(2n)]:border-l-0 lg:[&>*:nth-child(3n)]:border-r lg:[&>*:nth-child(3n-1):not(:last-child)]:border-x">
              {items.map((item) => {
                const key = teachingEntryKey(item);
                const manifestRecords = [
                  ...(cachedTeachingMedia[key] ?? []),
                  ...(teachingPreviews[item.title] ?? []),
                ].filter((media, index, records) =>
                  records.findIndex((record) => normalizeMediaSrc(record.src) === normalizeMediaSrc(media.src)) === index &&
                  !excludedMedia.has(normalizeMediaSrc(media.src)) &&
                  localMediaPath(normalizeMediaSrc(media.src)),
                );
                const fallbackSource = item.image ?? item.ogImage;
                const fallbackRecords =
                  fallbackSource && localMediaPath(normalizeMediaSrc(fallbackSource))
                    ? [
                        {
                          src: fallbackSource,
                          kind: "image",
                        },
                      ]
                    : [];
                const mediaRecords = manifestRecords.length
                  ? manifestRecords
                  : fallbackRecords;
                const hasMedia = mediaRecords.length > 0;

                const columnCount = hasMedia
                  ? Math.min(
                      mediaRecords.length === 1 ? 2 : mediaRecords.length,
                      3
                    )
                  : 0;
                const gridStyle = columnCount
                  ? {
                      gridTemplateColumns: `repeat(${columnCount}, minmax(0, 1fr))`,
                    }
                  : {};

                const imageSection = hasMedia && (
                  <div
                    class="image-container overflow-hidden"
                  >
                    <div class="medias" style={gridStyle}>
                      {mediaRecords.map((media, index) => {
                        const src = media?.src ?? media?.path ?? media?.url;
                        if (!src) return null;

                        const isVideo =
                          media?.kind === "video" ||
                          /\.(mp4|webm|ogg)$/i.test(src);

                        const baseClass = "aspect-[16/9]";
                        const offsetClass =
                          mediaRecords.length === 1 ? "md:col-start-2" : "";
                        const mediaClasses = [baseClass]
                          .filter(Boolean)
                          .join(" ");

                        return (
                          <div
                            key={`${key}-${index}`}
                            class={`flex flex-col gap-2 ${offsetClass}`}
                          >
                            <Media
                              src={src}
                              alt={
                                media?.caption?.length
                                  ? media.caption
                                  : `${item.title} media ${index + 1}`
                              }
                              isVideo={isVideo}
                              usePoster={true}
                              placeholder={false}
                              className={mediaClasses}
                              cropped={index === 0}
                              widthAuto={false}
                            />
                            {media?.caption && (
                              <p class="body2 code text-pretty text-gray-600">
                                {media.caption}
                              </p>
                            )}
                          </div>
                        );
                      })}
                    </div>
                  </div>
                );

                const content = (
                  <article
                    class="teaching-card flex h-full flex-col justify-between gap-x-20 gap-y-10 overflow-hidden border-b px-[var(--page-margin)] py-6 lg:flex-col lg:gap-y-4 lg:py-6"
                    data-has-image={hasMedia ? "true" : "false"}
                  >
                    <div class={`mb-8 w-full lg:mb-4`}>
                      <h3 class="heading2 items-center gap-2 text-balance">
                        {item.title}
                        {item.link?.href && (
                          <ExternalLinkArrow revealOnHover />
                        )}
                      </h3>
                      {item.place && (
                        <p class="body1 mt-2 text-pretty text-gray-600">
                          {item.place}
                        </p>
                      )}
                      <p class="body1 mt-4 w-max rounded-full border bg-black px-4 py-1 text-pretty text-gray-200">
                        {displayDate(item)}
                      </p>
                      {item.note && (
                        <p class="body1 mt-2 text-pretty text-gray-600">
                          {item.note}
                        </p>
                      )}
                    </div>
                    {imageSection ? (
                      <div class="flex w-full flex-col gap-4 lg:w-full">
                        {imageSection}
                      </div>
                    ) : null}
                  </article>
                );

                if (item.link?.href) {
                  return (
                    <a
                      key={key}
                      href={item.link.href}
                      class="teaching-link fade-in block h-full !no-underline transition-opacity duration-200 hover:opacity-80 focus-visible:opacity-80"
                      {...externalLinkAttrs(item.link.href)}
                    >
                      {content}
                    </a>
                  );
                }

                return (
                  <div key={key} class="teaching-link fade-in block h-full">
                    {content}
                  </div>
                );
              })}
            </div>
          </section>
        ))
    }
  </main>
</BasicLayout>
